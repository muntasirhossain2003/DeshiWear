NODE_ENV=development
PORT=9002
JWT_SECRET=replace-with-a-long-random-secret
# Use MongoDB Atlas M0 for a free hosted database; omit locally to use embedded MongoDB.
MONGO_URI=
# Optional: configure one or both providers for Deshi Sohayok.
GROQ_API_KEY=
GEMINI_API_KEY=
# Comma-separated browser origins in production; same-origin Render hosting can leave this blank.
FRONTEND_URL=
